{
  "name": "linear-linux",
  "version": "0.2.58",
  "description": "Linux support for linear.app",
  "main": "./out/main/index.js",
  "author": "Selimaj Dev",
  "license": "ISC",
  "homepage": "https://github.com/rayleigh420/linear-linux#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayleigh420/linear-linux.git"
  },
  "bugs": {
    "url": "https://github.com/rayleigh420/linear-linux/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "electron-vite dev -- --no-sandbox --disable-dev-shm-usage",
    "build": "npm run typecheck && electron-vite build",
    "start": "ELECTRON_DISABLE_SANDBOX=1 electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "dockview-react": "^7.0.4",
    "electron-updater": "^6.6.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
