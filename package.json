{
  "name": "linear-linux",
  "version": "0.2.51",
  "description": "Linux support for linear.app",
  "main": "./out/main/index.js",
  "author": "Selimaj Dev",
  "license": "ISC",
  "homepage": "https://github.com/rayleigh420/linear-linux#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayleigh420/linear-linux.git"
  },
  "bugs": {
    "url": "https://github.com/rayleigh420/linear-linux/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "dev": "electron-vite dev -- --no-sandbox --disable-dev-shm-usage",
    "build": "electron-vite build",
    "start": "ELECTRON_DISABLE_SANDBOX=1 electron-vite preview",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6"
  }
}
